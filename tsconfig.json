{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "app/layout.jsx",
    "app/page.jsx",
    "app/writing/page.jsx",
    "components/SiteNavigation.jsx",
    "components/HeroSection.jsx",
    "components/SiteFooter.jsx",
    "providers/ThemeProvider.jsx",
    "components/ThemeToggle.jsx",
    "components/DottedUnderline.jsx",
    "components/ProjectSection.jsx",
    "components/CompaniesWorkedWith.jsx",
    "components/BlurAccordion.jsx",
    "components/FocusAreas.jsx",
    "components/WritingList.jsx",
    "components/WritingSection.jsx",
    "components/DailyQuoteSection.jsx",
    "components/GitHubActivity.jsx",
    "lib/github.js"
  ],
  "exclude": ["node_modules"]
}
